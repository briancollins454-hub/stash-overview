    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "firebase": "^12.11.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.460.0",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.9",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.0.227",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.2",
    "react-window": "^2.2.7",
    "recharts": "^3.8.0",
    "resend": "^6.10.0",
    "tsx": "^4.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
