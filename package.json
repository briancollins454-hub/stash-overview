{
  "name": "stash-shop-sync",
  "version": "19.4.0",
  "private": true,
  "description": "Shopify x DecoNetwork Production Bridge",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "tsx server.ts",
    "mizuno:scrape-full": "node scripts/mizuno-teamwear/scrape-full.mjs",
    "mizuno:enrich-colors": "node scripts/mizuno-teamwear/enrich-scrape-colors.mjs",
    "mizuno:refresh-stock": "node scripts/mizuno-teamwear/refresh-scrape-stock.mjs",
    "mizuno:shopify-import": "node scripts/mizuno-teamwear/import-shopify-csv.mjs",
    "mizuno:syncx-xlsx": "python3 scripts/mizuno-teamwear/build-syncx-xlsx-from-shopify-export.py",
    "mcp:stash": "tsx mcp/stash-stdio.ts",
    "label-printer:build": "npm install --prefix label-printer && npm run build --prefix label-printer",
    "label-printer:dev": "npm install --prefix label-printer && npm run dev --prefix label-printer"
  },
  "dependencies": {
    "@google/genai": "^1.37.0",
