{
  "functions": {
    "api/mcp.ts": { "maxDuration": 60 },
    "api/mcp/oauth/authorize.ts": { "maxDuration": 30 },
    "api/mcp/oauth/token.ts": { "maxDuration": 30 },
    "api/mcp/oauth/register.ts": { "maxDuration": 15 },
    "api/deco.ts": {
      "maxDuration": 60,
      "includeFiles": "node_modules/@napi-rs/canvas/**"
    },
    "api/inventory.ts": { "maxDuration": 60 },
    "api/stock.ts": { "maxDuration": 60 },
    "api/shopify.ts": { "maxDuration": 60 },
    "api/cron/refresh-finance.ts": { "maxDuration": 60 },
    "api/cron/invoice-reminders.ts": { "maxDuration": 300 },
    "api/qbo/callback.ts": { "maxDuration": 60 },
    "api/qbo-auth/index.ts": { "maxDuration": 60 }
  },
  "crons": [
    {
      "path": "/api/cron/refresh-finance",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/invoice-reminders",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/mcp-oauth-well-known?type=resource" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/mcp-oauth-well-known?type=server" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api/).*)", "destination": "/" }
  ]
}
