# Shopify Configuration (server-side only — do NOT use VITE_ prefix for secrets)
SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# DecoNetwork Configuration
DECO_DOMAIN=
DECO_USERNAME=
DECO_PASSWORD=

# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Gemini AI (server-side only)
GEMINI_API_KEY=

# OpenAI GPT-4.1 (server-side only)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1

# TTS Voice (OpenAI voices: alloy, echo, fable, onyx, nova, shimmer)
# TTS_VOICE=nova

# ElevenLabs TTS (optional premium voice — falls back to OpenAI if not set)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# Shopify App (OAuth - server-side only)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
APP_URL=http://localhost:3000
# --- Email sending ---
# Preferred: send via the Marx Corporate Google Workspace mailbox over SMTP so emails come
# genuinely from accounts@marxcorporate.com. Generate a Google App Password (Google Account →
# Security → 2-Step Verification → App passwords) for the accounts@marxcorporate.com mailbox.
SMTP_USER=accounts@marxcorporate.com
SMTP_PASS=
# Optional SMTP overrides (defaults shown):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=Marx Corporate <accounts@marxcorporate.com>
#
# Fallback: Resend (used only if SMTP_USER/SMTP_PASS are not set). FROM must use a Resend-verified domain.
RESEND_API_KEY=
# DIGEST_FROM_EMAIL=Stash Overview <digest@stashoverview.co.uk>
# STATEMENT_REPLY_TO=accounts@marxcorporate.com

# --- Claude web connector (remote MCP + OAuth) ---
# Deploy these on Vercel. Users add https://www.stashoverview.co.uk/api/mcp in Claude → Connectors.
# MCP_OAUTH_SECRET=long-random-string
# MCP_CONNECT_PASSWORD=password-shown-on-stash-consent-page
# Optional fixed OAuth client (Claude → Advanced settings); DCR works without these:
# MCP_OAUTH_CLIENT_ID=stash-claude
# MCP_OAUTH_CLIENT_SECRET=another-long-secret
# APP_URL must match the public URL Claude uses (e.g. https://www.stashoverview.co.uk)

# --- Automated payment reminders (replaces QuickBooks workflow automation) ---
# Required for the nightly reminder cron (also used by refresh-finance). Vercel
# sends this as a Bearer token on scheduled invocations.
CRON_SECRET=
# Emergency kill-switch: set to 'true' to stop ALL reminders regardless of UI mode.
# REMINDERS_DISABLED=false
